POSTGRES_USER=devflow_user
POSTGRES_PASSWORD=devflow_password
POSTGRES_DB=devflow_db
POSTGRES_INITDB_ARGS="--encoding=UTF-8 --locale=en_US.UTF-8"

REDIS_PASSWORD=devflow_redis_password
REDIS_PORT=6379
REDIS_DB=0

DATABASE_URL=postgresql+asyncpg://devflow_user:devflow_password@localhost:5432/devflow_db
REDIS_URL=redis://:devflow_redis_password@localhost:6379/0

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
REDIS_POOL_SIZE=10

JWT_SECRET=devflow-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

APP_NAME=DevFlow
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
