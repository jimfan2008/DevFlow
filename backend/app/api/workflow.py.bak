@router.post("/{project_id}/step13/execute")
async def execute_step13_async(project_id: str, db: Session = Depends(get_db), current_user=Depends(get_current_user)):
    """异步启动第十三步：后富部署代码到生产环境（约30分钟），立即返回"""
    from app.services.gateway_client import GatewayClient
    import asyncio as _asyncio
    try:
        engine = _get_engine(project_id, db)
        engine.advance_step(13)
    except Exception as e:
        return APIResponse(code=1, message=f"无法开始步骤13: {str(e)[:200]}")
    step9 = engine.get_step9_artifacts() or {}
    code = step9.get("code") or step9.get("content") or ""
    step11 = engine.get_step11_artifacts() or {}
    test_report = step11.get("test_report") or step11.get("report") or ""
    step12 = engine.get_step12_artifacts() or {}
    security_report = step12.get("security_report") or step12.get("report") or ""
    engine.save_step13_artifacts({"status": "generating", "message": "🚀 后富正在部署代码到生产环境..."})

    async def _generate():
        try:
            from app.database import SessionLocal
            from app.services.workflow_engine import WorkflowEngine
            from app.api.ws.step4_progress import broadcast
            bg_db = SessionLocal()
            try:
                bg_engine = WorkflowEngine(project_id=project_id, db=bg_db)
                await broadcast(project_id, {"type": "stage", "message": "📖 后富正在读取代码、测试报告和安全审计报告..."})
                await broadcast(project_id, {"type": "stage", "message": "🚀 后富正在部署代码到生产环境..."})
                prompt_lines = ["你是资深CI/CD工程师后富（HouFu），负责将代码部署到生产环境。\n"]
                if code:
                    prompt_lines.append(f"=== 功能代码 ===\n{code[:3000]}\n\n")
                if test_report:
                    prompt_lines.append(f"=== 测试报告 ===\n{str(test_report)[:2000]}\n\n")
                if security_report:
                    prompt_lines.append(f"=== 安全审计报告 ===\n{str(security_report)[:2000]}\n\n")
                prompt_lines.append(
                    "请将以上代码部署到生产环境，完成以下工作：\n"
                    "1. 准备生产环境（操作系统、运行时、依赖库）\n"
                    "2. 配置部署脚本（Docker、Docker Compose 或 K8s）\n"
                    "3. 配置环境变量和数据库连接\n"
                    "4. 执行部署流程并验证服务启动\n"
                    "5. 输出部署日志和验证结果\n\n"
                    "直接输出部署配置和过程。"
                )
                prompt = "\n".join(prompt_lines)
                full_reply = []
                client = GatewayClient(profile_name="houfu", timeout=3600)
                async for chunk in client.chat_completions(messages=[{"role": "user", "content": prompt}], stream=True, max_tokens=16384):
                    full_reply.append(chunk)
                    if len(full_reply) % 10 == 0:
                        await broadcast(project_id, {"type": "progress", "message": f"🚀 后富持续部署中...（已生成 {len(''.join(full_reply))} 字符）"})
                reply = "".join(full_reply).strip()
                if reply and len(reply) >= 50:
                    artifacts = {"deployment_log": reply, "code_source": str(code)[:500], "status": "done", "message": "✅ 生产环境部署完成"}
                    bg_engine.save_step13_artifacts(artifacts)
                    bg_engine.complete_step(13)
                    await broadcast(project_id, {"type": "done", "message": "✅ 生产环境部署已完成"})
                else:
                    bg_engine.save_step13_artifacts({"status": "error", "message": "❌ 后富未生成有效部署记录"})
                    bg_engine.reset_step(13)
                    await broadcast(project_id, {"type": "error", "message": "❌ 后富未生成有效部署记录"})
            except Exception as e:
                logger.error(f"HouFu background production deployment failed: {e}")
                try:
                    bg_engine = WorkflowEngine(project_id=project_id, db=bg_db)
                    bg_engine.save_step13_artifacts({"status": "error", "message": f"❌ 后富部署失败: {str(e)[:200]}"})
                    bg_engine.reset_step(13)
                except Exception: pass
            finally:
                bg_db.close()
        except Exception as e:
            logger.error(f"HouFu background task fatal: {e}")

    _asyncio.create_task(_generate())
    return APIResponse(code=0, data={"message": "第十三步已启动，后富正在部署代码到生产环境（约30分钟）", "status": "generating"})


