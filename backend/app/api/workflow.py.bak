@router.post("/{project_id}/step9/inspect")
async def inspect_step9_code(project_id: str, body: Step3InspectRequest,
                             db: Session = Depends(get_db),
                             current_user=Depends(get_current_user)):
    """后荣（HouRong）对功能代码进行QA自动检验"""
    content = body.content
    focus_items = body.focus_items or None
    if not content or len(content.strip()) < 20:
        return APIResponse(code=0, data={
            "passed": False, "message": "功能代码内容过短，请补充完善",
            "dimensions": [
                {"key": d["key"], "label": d["label"], "description": d["description"],
                 "passed": False, "detail": "代码内容不足，无法检验"}
                for d in CODE_INSPECTION_DIMENSIONS
            ],
        })

    from app.services.gateway_client import GatewayClient
    import json as _json

    active_dims = [d for d in CODE_INSPECTION_DIMENSIONS
                   if not focus_items or d["key"] in focus_items]

    dims_json = _json.dumps(
        [{'检验项目': d['label'], '检验标准': d['description']} for d in active_dims],
        ensure_ascii=False, indent=2
    )

    focus_hint = ""
    if focus_items:
        focus_hint = (
            f"\n⚠️ 本次只需重新检验以下 {len(active_dims)} 项：{[d['label'] for d in active_dims]}\n"
            f"请只针对这些项目做出通过/不通过判定，不要对其他维度提出新的问题。"
        )

    prompt = (
        "你是一个专业的代码QA检验员（后荣）。请严格检验以下功能代码是否符合开发标准。\n\n"
        "=== 功能代码 ===\n"
        f"{content}\n\n"
        "=== 检验项目与标准 ===\n"
        f"请依次逐项检验以下 {len(active_dims)} 个维度，对每个维度给出通过/不通过及具体意见：\n"
        f"{dims_json}\n\n"
        "请阅读完整代码，严格按照上述检验标准进行专业评审。\n"
        f"{focus_hint}\n"
        "直接输出 JSON 数组，不要包含其他说明文字：\n"
        "[\n"
        + ",\n".join(
            f'  {{"key": "{d["key"]}", "passed": true/false, "detail": "具体检验意见..."}}'
            for d in active_dims
        ) + "\n]"
    )

    INSPECT_TIMEOUT = 120
    try:
        client = GatewayClient(profile_name="hourong", timeout=INSPECT_TIMEOUT)

        async def _collect():
            chunks = []
            async for chunk in client.chat_completions(
                messages=[{"role": "user", "content": prompt}],
                stream=False,
                max_tokens=2000,
            ):
                chunks.append(chunk)
            return "".join(chunks).strip()

        reply = await asyncio.wait_for(_collect(), timeout=INSPECT_TIMEOUT)

        if not reply:
            raise ValueError("后荣未返回检验结果（空响应）")
        parsed_list = _json.loads(reply)
        if not isinstance(parsed_list, list):
            raise ValueError("返回结果不是数组")
    except _asyncio.TimeoutError:
        logger.error(f"后荣检验功能代码超时（{INSPECT_TIMEOUT}s）")
        return APIResponse(code=0, data={
            "passed": False,
            "message": f"检验超时（超过{INSPECT_TIMEOUT//60}分钟），请简化代码后重试",
            "dimensions": [
                {"key": d["key"], "label": d["label"], "description": d["description"],
                 "passed": False, "detail": "检验超时，请简化代码后重试"}
                for d in active_dims
            ],
        })
    except Exception as e:
        logger.error(f"后荣检验功能代码失败: {e}")
        return APIResponse(code=0, data={
            "passed": False, "message": "后荣检验过程出错，请重试",
            "dimensions": [
                {"key": d["key"], "label": d["label"], "description": d["description"],
                 "passed": False, "detail": f"检验失败: {str(e)[:80]}"}
                for d in active_dims
            ],
        })

    results = []
    for dim in active_dims:
        matched = next((r for r in parsed_list if r.get("key") == dim["key"]), None)
        if matched:
            dim_passed = bool(matched.get("passed", False))
            dim_detail = matched.get("detail", "")
        else:
            dim_passed = False
            dim_detail = "后荣未返回该维度的检验结果"
        results.append({
            "key": dim["key"], "label": dim["label"], "description": dim["description"],
            "passed": dim_passed, "detail": dim_detail,
        })

    all_passed = all(r["passed"] for r in results)
    return APIResponse(code=0, data={
        "passed": all_passed,
        "message": "所有检验项目均通过 ✅" if all_passed else "部分检验项目未通过，请修改后重新检验",
        "dimensions": results,
    })


@router.post("/{project_id}/step10")
def execute_step10(project_id: str,
                   db: Session = Depends(get_db),
                   current_user=Depends(get_current_user)):
    engine = _get_engine(project_id, db)
    engine.advance_step(10)
    step = engine.complete_step(10)
    return APIResponse(code=0, data={"message": "第十步：测试环境部署完成", "step": step})


@router.post("/{project_id}/step10/chat")
async def step10_chat(project_id: str, body: Step10ChatRequest,
                      db: Session = Depends(get_db),
                      current_user=Depends(get_current_user)):
    """与后富（HouFu）CI/CD工程师对话 - 使用项目隔离模式"""
    logger.info(f"Step10 chat: project_id={project_id}, message={body.message[:50]}")
    from app.services.gateway_client import GatewayClient
    from app.models.project import Project

    try:
        engine = _get_engine(project_id, db)
        step2 = engine.get_step2_artifacts()
        core_goal = step2.get("confirmed_goal") or step2.get("core_goal") or ""

        project = db.query(Project).filter(Project.id == project_id).first()
        if not project:
            raise HTTPException(status_code=404, detail="Project not found")

        messages = body.messages + [{"role": "user", "content": body.message}]

        client = GatewayClient(profile_name="houfu", timeout=1200)
        reply_chunks = []
        async for chunk in client.chat_isolated(
            messages=messages,
            project_id=project_id,
            project_name=project.name,
            project_description=project.description or "",
            core_goal=core_goal,
            agent_name="后富（HouFu）CI/CD工程师",
            stream=False,
        ):
            reply_chunks.append(chunk)
        reply = "".join(reply_chunks)
        if not reply or len(reply.strip()) < 5:
            return APIResponse(code=1, message="后富未生成有效回复", data=None)
        return APIResponse(code=0, message="success", data={"reply": reply})
    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"HouFu chat failed: {e}")
        return APIResponse(code=1, message="与后富对话失败，请稍后重试", data=None)


@router.post("/{project_id}/step10/execute")
async def execute_step10_async(project_id: str,
                               db: Session = Depends(get_db),
                               current_user=Depends(get_current_user)):
    """异步启动第十步：后富部署代码到测试环境（约30分钟），立即返回"""
    from app.services.gateway_client import GatewayClient
    import asyncio as _asyncio

    try:
        engine = _get_engine(project_id, db)
        engine.advance_step(10)
    except Exception as e:
        return APIResponse(code=1, message=f"无法开始步骤10: {str(e)[:200]}")

    step9 = engine.get_step9_artifacts() or {}
    code = (step9.get("code") or step9.get("content") or "")
    step3 = engine.get_step3_artifacts() or {}
    requirement = (step3.get("doc_content") or step3.get("content") or
                   step3.get("requirement") or step3.get("srs") or "")
    step4 = engine.get_step4_artifacts() or {}
    design_doc = step4.get("design_doc") or ""
    step5 = engine.get_step5_artifacts() or {}
    env_info = step5.get("env_info") or step5.get("environment") or {}

    engine.save_step10_artifacts({"status": "generating", "message": "🚀 后富正在部署代码到测试环境..."})

    async def _generate():
        """后台任务：后富部署代码到测试环境（约30分钟）"""
        try:
            from app.database import SessionLocal
            from app.services.workflow_engine import WorkflowEngine
            from app.api.ws.step4_progress import broadcast

            bg_db = SessionLocal()
            try:
                bg_engine = WorkflowEngine(project_id=project_id, db=bg_db)

                await broadcast(project_id, {"type": "stage", "message": "📖 后富正在读取代码和部署环境信息..."})
                await broadcast(project_id, {"type": "stage", "message": "🚀 后富正在准备测试环境部署..."})

                prompt_lines = [
                    "你是资深CI/CD工程师后富（HouFu），负责将代码部署到测试环境。\n",
                ]
                if requirement:
                    prompt_lines.append(
                        "=== 需求文档（SRS）===\n"
                        f"{requirement[:2000]}\n\n"
                    )
                if design_doc:
                    prompt_lines.append(
                        "=== 架构设计文档 ===\n"
                        f"{design_doc[:3000]}\n\n"
                    )
                if env_info:
                    prompt_lines.append(
                        "=== 开发环境信息 ===\n"
                        f"{_json.dumps(env_info, ensure_ascii=False, indent=2) if isinstance(env_info, (dict, list)) else str(env_info)}\n\n"
                    )
                if code:
                    prompt_lines.append(
                        "=== 功能代码 ===\n"
                        f"{code[:5000]}\n\n"
                    )
                prompt_lines.append(
                    "请将以上代码部署到测试环境，完成以下工作：\n"
                    "1. 准备测试环境（操作系统、运行时、依赖库）\n"
                    "2. 配置部署脚本（Docker、Docker Compose 或 K8s）\n"
                    "3. 配置环境变量和数据库连接\n"
                    "4. 执行部署流程并验证服务启动\n"
                    "5. 输出部署日志和验证结果\n\n"
                    "直接输出部署配置和过程，不要输出思考过程。"
                )
                prompt = "\n".join(prompt_lines)

                full_reply = []
                client = GatewayClient(profile_name="houfu", timeout=3600)  # 60分钟超时
                async for chunk in client.chat_completions(
                    messages=[{"role": "user", "content": prompt}],
                    stream=True,
                    max_tokens=16384,
                ):
                    full_reply.append(chunk)
                    if len(full_reply) % 10 == 0:
                        await broadcast(project_id, {"type": "progress", "message": f"🚀 后富持续部署中...（已生成 {len(''.join(full_reply))} 字符）"})

                await broadcast(project_id, {"type": "stage", "message": "📝 部署完成，正在进行验证..."})

                reply = "".join(full_reply).strip()
                if reply and len(reply) >= 50:
                    artifacts = {
                        "deployment_log": reply,
                        "code_source": str(code)[:500],
                        "status": "done",
                        "message": "✅ 测试环境部署完成",
                    }
                    bg_engine.save_step10_artifacts(artifacts)
                    bg_engine.complete_step(10)
                    await broadcast(project_id, {"type": "done", "message": "✅ 测试环境部署已完成，等待 QA 检验"})
                else:
                    bg_engine.save_step10_artifacts({
                        "status": "error",
                        "message": "❌ 后富未生成有效部署记录，请重新执行",
                    })
                    bg_engine.reset_step(10)
                    await broadcast(project_id, {"type": "error", "message": "❌ 后富未生成有效部署记录，请重新执行"})
            except Exception as e:
                logger.error(f"HouFu background deployment failed: {e}")
                try:
                    bg_engine = WorkflowEngine(project_id=project_id, db=bg_db)
                    bg_engine.save_step10_artifacts({
                        "status": "error",
                        "message": f"❌ 后富部署失败: {str(e)[:200]}",
                    })
                    bg_engine.reset_step(10)
                except Exception:
                    pass
                try:
                    await broadcast(project_id, {"type": "error", "message": f"❌ 后富部署失败: {str(e)[:200]}"})
                except Exception:
                    pass
            finally:
                bg_db.close()
        except Exception as e:
            logger.error(f"HouFu background task fatal: {e}")

    _asyncio.create_task(_generate())

    return APIResponse(code=0, data={
        "message": "第十步已启动，后富正在部署代码到测试环境（约30分钟）",
        "status": "generating",
    })


