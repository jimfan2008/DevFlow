                    full_reply.append(chunk)
                    if len(full_reply) % 10 == 0:
                        await broadcast(project_id, {"type": "progress", "message": f"📝 后贵持续编写文档中...（已生成 {len(''.join(full_reply))} 字符）"})
                reply = "".join(full_reply).strip()
                if reply and len(reply) >= 50:
                    artifacts = {"documentation": reply, "status": "done", "message": "✅ 项目文档完善完成"}
                    bg_engine.save_step14_artifacts(artifacts)
                    bg_engine.complete_step(14)
                    await broadcast(project_id, {"type": "done", "message": "✅ 项目文档已完善完毕，等待 QA 检验"})
                else:
                    bg_engine.save_step14_artifacts({"status": "error", "message": "❌ 后贵未生成有效文档"})
                    bg_engine.reset_step(14)
                    await broadcast(project_id, {"type": "error", "message": "❌ 后贵未生成有效文档"})
            except Exception as e:
                logger.error(f"HouGui background documentation failed: {e}")
                try:
                    bg_engine = WorkflowEngine(project_id=project_id, db=bg_db)
                    bg_engine.save_step14_artifacts({"status": "error", "message": f"❌ 后贵文档编写失败: {str(e)[:200]}"})
                    bg_engine.reset_step(14)
                except Exception: pass
            finally:
                bg_db.close()
        except Exception as e:
            logger.error(f"HouGui background task fatal: {e}")

    _asyncio.create_task(_generate())
    return APIResponse(code=0, data={"message": "第十四步已启动，后贵正在完善项目文档（约40分钟）", "status": "generating"})


