# ==================== Step 8: 海梅制订代码编写计划 ====================

@router.post("/{project_id}/step8/execute")
async def execute_step8_async(project_id: str, db: Session = Depends(get_db), current_user=Depends(get_current_user)):
    """异步启动第八步：海梅制订代码编写计划+依赖图（约20分钟），立即返回"""
    from app.services.gateway_client import GatewayClient
    import asyncio as _asyncio
    try:
        engine = _get_engine(project_id, db)
        engine.advance_step(8)
    except Exception as e:
        return APIResponse(code=1, message=f"无法开始步骤8: {str(e)[:200]}")
    step3 = engine.get_step3_artifacts() or {}
    requirement = (step3.get("doc_content") or step3.get("content") or step3.get("requirement") or step3.get("srs") or "")
    step4 = engine.get_step4_artifacts() or {}
    design_doc = step4.get("design_doc") or ""
    step7 = engine.get_step7_artifacts() or {}
    tdd_cases = step7.get("tdd_cases") or step7.get("test_cases") or ""
    engine.save_step8_artifacts({"status": "generating", "message": "📋 海梅正在制订代码编写计划..."})

    async def _generate():
        try:
            from app.database import SessionLocal
            from app.services.workflow_engine import WorkflowEngine
            from app.api.ws.step4_progress import broadcast
            bg_db = SessionLocal()
            try:
                bg_engine = WorkflowEngine(project_id=project_id, db=bg_db)
                await broadcast(project_id, {"type": "stage", "message": "📖 海梅正在读取需求文档、设计文档和TDD测试用例..."})
                await broadcast(project_id, {"type": "stage", "message": "📋 海梅正在制订代码编写计划+任务依赖图..."})
                prompt_lines = ["你是资深项目经理海梅（HaiMei），负责制订代码编写计划和任务依赖图。\n"]
                if requirement:
                    prompt_lines.append(f"=== 需求文档（SRS）===\n{requirement[:2000]}\n\n")
                if design_doc:
                    prompt_lines.append(f"=== 架构设计文档 ===\n{design_doc[:2000]}\n\n")
                if tdd_cases:
                    prompt_lines.append(f"=== TDD测试用例 ===\n{str(tdd_cases)[:2000]}\n\n")
                prompt_lines.append(
                    "请制订完整的代码编写计划：\n"
                    "1. 每个代码编写任务最小原子化\n"
                    "2. 每个任务有TDD测试用例一一对应\n"
                    "3. 画出任务依赖图（标注前置依赖和执行顺序）\n"
                    "4. 标注每个任务的优先级和预计工时\n\n"
                    "直接输出代码编写计划和依赖图。"
                )
                prompt = "\n".join(prompt_lines)
                full_reply = []
                client = GatewayClient(profile_name="haimei", timeout=2700)
                async for chunk in client.chat_completions(messages=[{"role": "user", "content": prompt}], stream=True, max_tokens=16384):
                    full_reply.append(chunk)
                    if len(full_reply) % 10 == 0:
                        await broadcast(project_id, {"type": "progress", "message": f"📋 海梅持续制订计划中...（已生成 {len(''.join(full_reply))} 字符）"})
                reply = "".join(full_reply).strip()
                if reply and len(reply) >= 50:
                    artifacts = {"code_plan": reply, "requirement_source": requirement[:200], "status": "done", "message": "✅ 代码编写计划制订完成"}
                    bg_engine.save_step8_artifacts(artifacts)
                    bg_engine.complete_step(8)
                    await broadcast(project_id, {"type": "done", "message": "✅ 代码编写计划已制订完毕，等待 QA 检验"})
                else:
                    bg_engine.save_step8_artifacts({"status": "error", "message": "❌ 海梅未生成有效计划"})
                    bg_engine.reset_step(8)
                    await broadcast(project_id, {"type": "error", "message": "❌ 海梅未生成有效计划"})
            except Exception as e:
                logger.error(f"HaiMei background code plan failed: {e}")
                try:
                    bg_engine = WorkflowEngine(project_id=project_id, db=bg_db)
                    bg_engine.save_step8_artifacts({"status": "error", "message": f"❌ 海梅计划制订失败: {str(e)[:200]}"})
                    bg_engine.reset_step(8)
                except Exception: pass
            finally:
                bg_db.close()
        except Exception as e:
            logger.error(f"HaiMei background task fatal: {e}")

    _asyncio.create_task(_generate())
    return APIResponse(code=0, data={"message": "第八步已启动，海梅正在制订代码编写计划+依赖图（约20分钟）", "status": "generating"})


