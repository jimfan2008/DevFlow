@router.post("/{project_id}/step11/execute")
async def execute_step11_async(project_id: str, db: Session = Depends(get_db), current_user=Depends(get_current_user)):
    """异步启动第十一步：后达建立测试蜂群执行全面测试（约60分钟），立即返回"""
    from app.services.gateway_client import GatewayClient
    import asyncio as _asyncio
    try:
        engine = _get_engine(project_id, db)
        engine.advance_step(11)
    except Exception as e:
        return APIResponse(code=1, message=f"无法开始步骤11: {str(e)[:200]}")
    step3 = engine.get_step3_artifacts() or {}
    requirement = (step3.get("doc_content") or step3.get("content") or step3.get("requirement") or step3.get("srs") or "")
    step9 = engine.get_step9_artifacts() or {}
    code = step9.get("code") or step9.get("content") or ""
    step10 = engine.get_step10_artifacts() or {}
    deploy_log = step10.get("deployment_log") or step10.get("deploy_log") or ""
    engine.save_step11_artifacts({"status": "generating", "message": "🐝 后达正在建立蜂群执行全面测试..."})

    async def _generate():
        try:
            from app.database import SessionLocal
            from app.services.workflow_engine import WorkflowEngine
            from app.api.ws.step4_progress import broadcast
            bg_db = SessionLocal()
            try:
                bg_engine = WorkflowEngine(project_id=project_id, db=bg_db)
                await broadcast(project_id, {"type": "stage", "message": "📖 后达正在读取需求文档、功能代码和部署日志..."})
                await broadcast(project_id, {"type": "stage", "message": "🐝 后达正在建立测试蜂群执行全面测试（单元/模块/集成/前端实操）..."})
                prompt_lines = ["你是资深测试员后达（HouDa），负责建立Agent蜂群执行全面测试。\n"]
                if requirement:
                    prompt_lines.append(f"=== 需求文档（SRS）===\n{requirement[:2000]}\n\n")
                if code:
                    prompt_lines.append(f"=== 功能代码 ===\n{code[:3000]}\n\n")
                if deploy_log:
                    prompt_lines.append(f"=== 测试环境部署日志 ===\n{str(deploy_log)[:2000]}\n\n")
                prompt_lines.append(
                    "请建立Agent蜂群执行全面测试：\n"
                    "1. 单元测试（每个函数/方法的独立测试）\n"
                    "2. 模块测试（模块间的接口测试）\n"
                    "3. 集成测试（系统整体的集成测试）\n"
                    "4. 前端实操验证（页面功能、交互、样式验证）\n"
                    "5. 输出完整的测试报告和缺陷清单\n\n"
                    "直接输出测试过程和结果。"
                )
                prompt = "\n".join(prompt_lines)
                full_reply = []
                client = GatewayClient(profile_name="houda", timeout=5400)
                async for chunk in client.chat_completions(messages=[{"role": "user", "content": prompt}], stream=True, max_tokens=16384):
                    full_reply.append(chunk)
                    if len(full_reply) % 10 == 0:
                        await broadcast(project_id, {"type": "progress", "message": f"🐝 后达持续测试中...（已生成 {len(''.join(full_reply))} 字符）"})
                reply = "".join(full_reply).strip()
                if reply and len(reply) >= 50:
                    artifacts = {"test_report": reply, "code_source": str(code)[:500], "status": "done", "message": "✅ 全面测试完成"}
                    bg_engine.save_step11_artifacts(artifacts)
                    bg_engine.complete_step(11)
                    await broadcast(project_id, {"type": "done", "message": "✅ 全面测试已完成，等待 QA 检验"})
                else:
                    bg_engine.save_step11_artifacts({"status": "error", "message": "❌ 后达未生成有效测试报告"})
                    bg_engine.reset_step(11)
                    await broadcast(project_id, {"type": "error", "message": "❌ 后达未生成有效测试报告"})
            except Exception as e:
                logger.error(f"HouDa background testing failed: {e}")
                try:
                    bg_engine = WorkflowEngine(project_id=project_id, db=bg_db)
                    bg_engine.save_step11_artifacts({"status": "error", "message": f"❌ 后达测试执行失败: {str(e)[:200]}"})
                    bg_engine.reset_step(11)
                except Exception: pass
            finally:
                bg_db.close()
        except Exception as e:
            logger.error(f"HouDa background task fatal: {e}")

    _asyncio.create_task(_generate())
    return APIResponse(code=0, data={"message": "第十一步已启动，后达正在建立蜂群执行全面测试（约60分钟）", "status": "generating"})


