    return APIResponse(code=0, data={"message": f"第五步QA检验{'通过' if body.result == 'passed' else '未通过'}", "qa": result})


# ==================== Step 6: 海梅制订TDD测试用例计划 ====================

@router.post("/{project_id}/step6/execute")
async def execute_step6_async(project_id: str,
                              db: Session = Depends(get_db),
                              current_user=Depends(get_current_user)):
    """异步启动第六步：海梅制订TDD测试用例编写计划（约15分钟），立即返回"""
    from app.services.gateway_client import GatewayClient
    import asyncio as _asyncio

    try:
        engine = _get_engine(project_id, db)
        engine.advance_step(6)
    except Exception as e:
        return APIResponse(code=1, message=f"无法开始步骤6: {str(e)[:200]}")

    step3 = engine.get_step3_artifacts() or {}
    requirement = (step3.get("doc_content") or step3.get("content") or step3.get("requirement") or step3.get("srs") or "")
    step4 = engine.get_step4_artifacts() or {}
    design_doc = step4.get("design_doc") or ""
    step5 = engine.get_step5_artifacts() or {}
    env_info = step5.get("env_info") or step5.get("environment") or ""

    engine.save_step6_artifacts({"status": "generating", "message": "📋 海梅正在制订TDD测试用例编写计划..."})

    async def _generate():
        """后台任务：海梅制订TDD测试用例编写计划（约15分钟）"""
        try:
            from app.database import SessionLocal
            from app.services.workflow_engine import WorkflowEngine
            from app.api.ws.step4_progress import broadcast

            bg_db = SessionLocal()
            try:
                bg_engine = WorkflowEngine(project_id=project_id, db=bg_db)

                await broadcast(project_id, {"type": "stage", "message": "📖 海梅正在读取需求文档、设计文档和环境配置..."})
                await broadcast(project_id, {"type": "stage", "message": "📋 海梅正在制订TDD测试用例编写计划（原子化测试用例、验收标准）..."})

                prompt_lines = [
                    "你是资深项目经理海梅（HaiMei），负责制订TDD测试用例编写计划。\n",
                ]
                if requirement:
                    prompt_lines.append(f"=== 需求文档（SRS）===\n{requirement[:3000]}\n\n")
                if design_doc:
                    prompt_lines.append(f"=== 架构设计文档 ===\n{design_doc[:2000]}\n\n")
                prompt_lines.append(
                    "请根据上述需求说明书和架构设计文档，制订完整的TDD测试用例编写计划：\n"
                    "1. 每个测试用例最小原子化（不可再分）\n"
                    "2. 每个测试用例有明确可量化的验收标准\n"
                    "3. 覆盖所有功能需求和非功能需求\n"
                    "4. 标注每个测试用例的优先级和执行顺序\n\n"
                    "直接输出测试计划，标注测试用例编号、名称、验收标准、优先级。"
                )
                prompt = "\n".join(prompt_lines)

                full_reply = []
                client = GatewayClient(profile_name="haimei", timeout=1800)
                async for chunk in client.chat_completions(messages=[{"role": "user", "content": prompt}], stream=True, max_tokens=16384):
                    full_reply.append(chunk)
                    if len(full_reply) % 10 == 0:
                        await broadcast(project_id, {"type": "progress", "message": f"📋 海梅持续制订计划中...（已生成 {len(''.join(full_reply))} 字符）"})

                reply = "".join(full_reply).strip()
                if reply and len(reply) >= 50:
                    artifacts = {"tdd_plan": reply, "requirement_source": requirement[:200], "status": "done", "message": "✅ TDD测试用例编写计划制订完成"}
                    bg_engine.save_step6_artifacts(artifacts)
                    bg_engine.complete_step(6)
                    await broadcast(project_id, {"type": "done", "message": "✅ TDD测试用例编写计划已制订完毕，等待 QA 检验"})
                else:
                    bg_engine.save_step6_artifacts({"status": "error", "message": "❌ 海梅未生成有效计划，请重新执行"})
                    bg_engine.reset_step(6)
                    await broadcast(project_id, {"type": "error", "message": "❌ 海梅未生成有效计划，请重新执行"})
            except Exception as e:
                logger.error(f"HaiMei background TDD plan failed: {e}")
                try:
                    bg_engine = WorkflowEngine(project_id=project_id, db=bg_db)
                    bg_engine.save_step6_artifacts({"status": "error", "message": f"❌ 海梅计划制订失败: {str(e)[:200]}"})
                    bg_engine.reset_step(6)
                except Exception: pass
            finally:
                bg_db.close()
        except Exception as e:
            logger.error(f"HaiMei background task fatal: {e}")

    _asyncio.create_task(_generate())
    return APIResponse(code=0, data={"message": "第六步已启动，海梅正在制订TDD测试用例编写计划（约15分钟）", "status": "generating"})


