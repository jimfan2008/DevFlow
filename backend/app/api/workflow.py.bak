@router.post("/{project_id}/step12/execute")
async def execute_step12_async(project_id: str, db: Session = Depends(get_db), current_user=Depends(get_current_user)):
    """异步启动第十二步：后华执行安全审计（约45分钟），立即返回"""
    from app.services.gateway_client import GatewayClient
    import asyncio as _asyncio
    try:
        engine = _get_engine(project_id, db)
        engine.advance_step(12)
    except Exception as e:
        return APIResponse(code=1, message=f"无法开始步骤12: {str(e)[:200]}")
    step9 = engine.get_step9_artifacts() or {}
    code = step9.get("code") or step9.get("content") or ""
    step4 = engine.get_step4_artifacts() or {}
    design_doc = step4.get("design_doc") or ""
    engine.save_step12_artifacts({"status": "generating", "message": "🔒 后华正在执行安全审计..."})

    async def _generate():
        try:
            from app.database import SessionLocal
            from app.services.workflow_engine import WorkflowEngine
            from app.api.ws.step4_progress import broadcast
            bg_db = SessionLocal()
            try:
                bg_engine = WorkflowEngine(project_id=project_id, db=bg_db)
                await broadcast(project_id, {"type": "stage", "message": "📖 后华正在读取功能代码和架构设计..."})
                await broadcast(project_id, {"type": "stage", "message": "🔒 后华正在执行安全审计（代码审计/合规审查/渗透测试/漏洞修复）..."})
                prompt_lines = ["你是资深安全员后华（HouHua），负责执行安全审计。\n"]
                if design_doc:
                    prompt_lines.append(f"=== 架构设计文档 ===\n{design_doc[:2000]}\n\n")
                if code:
                    prompt_lines.append(f"=== 功能代码 ===\n{code[:3000]}\n\n")
                prompt_lines.append(
                    "请执行完整的安全审计：\n"
                    "1. 代码审计（SQL注入、XSS、CSRF、敏感信息泄露等）\n"
                    "2. 合规审查（是否符合行业规范和法规）\n"
                    "3. 渗透测试（模拟攻击测试系统安全性）\n"
                    "4. 漏洞修复建议（针对发现的问题给出修复方案）\n\n"
                    "直接输出安全审计报告。"
                )
                prompt = "\n".join(prompt_lines)
                full_reply = []
                client = GatewayClient(profile_name="houhua", timeout=3600)
                async for chunk in client.chat_completions(messages=[{"role": "user", "content": prompt}], stream=True, max_tokens=16384):
                    full_reply.append(chunk)
                    if len(full_reply) % 10 == 0:
                        await broadcast(project_id, {"type": "progress", "message": f"🔒 后华持续审计中...（已生成 {len(''.join(full_reply))} 字符）"})
                reply = "".join(full_reply).strip()
                if reply and len(reply) >= 50:
                    artifacts = {"security_report": reply, "code_source": str(code)[:500], "status": "done", "message": "✅ 安全审计完成"}
                    bg_engine.save_step12_artifacts(artifacts)
                    bg_engine.complete_step(12)
                    await broadcast(project_id, {"type": "done", "message": "✅ 安全审计已完成，等待 QA 检验"})
                else:
                    bg_engine.save_step12_artifacts({"status": "error", "message": "❌ 后华未生成有效安全报告"})
                    bg_engine.reset_step(12)
                    await broadcast(project_id, {"type": "error", "message": "❌ 后华未生成有效安全报告"})
            except Exception as e:
                logger.error(f"HouHua background audit failed: {e}")
                try:
                    bg_engine = WorkflowEngine(project_id=project_id, db=bg_db)
                    bg_engine.save_step12_artifacts({"status": "error", "message": f"❌ 后华审计执行失败: {str(e)[:200]}"})
                    bg_engine.reset_step(12)
                except Exception: pass
            finally:
                bg_db.close()
        except Exception as e:
            logger.error(f"HouHua background task fatal: {e}")

    _asyncio.create_task(_generate())
    return APIResponse(code=0, data={"message": "第十二步已启动，后华正在执行安全审计（约45分钟）", "status": "generating"})


