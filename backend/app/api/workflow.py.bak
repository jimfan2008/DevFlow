@router.post("/{project_id}/step9/chat")
async def step9_chat(project_id: str, body: Step9ChatRequest,
                     db: Session = Depends(get_db),
                     current_user=Depends(get_current_user)):
    """与后发（HouFa）程序员对话 - 使用项目隔离模式"""
    logger.info(f"Step9 chat: project_id={project_id}, message={body.message[:50]}")
    from app.services.gateway_client import GatewayClient
    from app.models.project import Project

    try:
        engine = _get_engine(project_id, db)
        step2 = engine.get_step2_artifacts()
        core_goal = step2.get("confirmed_goal") or step2.get("core_goal") or ""

        project = db.query(Project).filter(Project.id == project_id).first()
        if not project:
            raise HTTPException(status_code=404, detail="Project not found")

        messages = body.messages + [{"role": "user", "content": body.message}]

        client = GatewayClient(profile_name="houfa", timeout=1200)
        reply_chunks = []
        async for chunk in client.chat_isolated(
            messages=messages,
            project_id=project_id,
            project_name=project.name,
            project_description=project.description or "",
            core_goal=core_goal,
            agent_name="后发（HouFa）程序员",
            stream=False,
        ):
            reply_chunks.append(chunk)
        reply = "".join(reply_chunks)
        if not reply or len(reply.strip()) < 5:
            return APIResponse(code=1, message="后发未生成有效回复", data=None)
        return APIResponse(code=0, message="success", data={"reply": reply})
    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"HouFa chat failed: {e}")
        return APIResponse(code=1, message="与后发对话失败，请稍后重试", data=None)


@router.post("/{project_id}/step9/execute")
async def execute_step9_async(project_id: str,
                              db: Session = Depends(get_db),
                              current_user=Depends(get_current_user)):
    """异步启动第九步：后发建立Agent蜂群编写功能代码（约60分钟），立即返回"""
    from app.services.gateway_client import GatewayClient
    import asyncio as _asyncio

    try:
        engine = _get_engine(project_id, db)
        engine.advance_step(9)
    except Exception as e:
        return APIResponse(code=1, message=f"无法开始步骤9: {str(e)[:200]}")

    step8 = engine.get_step8_artifacts() or {}
    code_plan = (step8.get("code_plan") or step8.get("plan_content") or {})
    dependency_graph = step8.get("dependency_graph") or {}
    step3 = engine.get_step3_artifacts() or {}
    requirement = (step3.get("doc_content") or step3.get("content") or
                   step3.get("requirement") or step3.get("srs") or "")
    step4 = engine.get_step4_artifacts() or {}
    design_doc = step4.get("design_doc") or ""
    step6 = engine.get_step6_artifacts() or {}
    tdd_plan = step6.get("tdd_plan") or {}
    step7 = engine.get_step7_artifacts() or {}
    tdd_cases = (step7.get("tdd_cases") or step7.get("test_cases") or
                 step7.get("content") or "")

    engine.save_step9_artifacts({"status": "generating", "message": "🐝 后发正在建立蜂群编写功能代码..."})

    async def _generate():
        """后台任务：后发建立蜂群按依赖图顺序编写功能代码（约60分钟）"""
        try:
            from app.database import SessionLocal
            from app.services.workflow_engine import WorkflowEngine
            from app.api.ws.step4_progress import broadcast

            bg_db = SessionLocal()
            try:
                bg_engine = WorkflowEngine(project_id=project_id, db=bg_db)

                await broadcast(project_id, {"type": "stage", "message": "📖 后发正在读取代码编写计划、任务依赖图和TDD测试用例..."})
                await broadcast(project_id, {"type": "stage", "message": "🐝 后发正在建立Agent蜂群，按依赖图顺序分发任务..."})

                prompt_lines = [
                    "你是资深程序员后发（HouFa），负责建立Agent蜂群编写功能代码。\n",
                ]
                if requirement:
                    prompt_lines.append(
                        "=== 需求文档（SRS）===\n"
                        f"{requirement[:2000]}\n\n"
                    )
                if design_doc:
                    prompt_lines.append(
                        "=== 架构设计文档 ===\n"
                        f"{design_doc[:3000]}\n\n"
                    )
                prompt_lines.append(
                    "=== 代码编写计划 ===\n"
                    f"{_json.dumps(code_plan, ensure_ascii=False, indent=2) if isinstance(code_plan, (dict, list)) else str(code_plan)}\n\n"
                )
                if dependency_graph:
                    prompt_lines.append(
                        "=== 任务依赖图 ===\n"
                        f"{_json.dumps(dependency_graph, ensure_ascii=False, indent=2) if isinstance(dependency_graph, (dict, list)) else str(dependency_graph)}\n\n"
                    )
                prompt_lines.append(
                    "=== TDD测试用例 ===\n"
                    f"{tdd_cases if isinstance(tdd_cases, str) else (_json.dumps(tdd_cases, ensure_ascii=False, indent=2) if tdd_cases else '待生成')}\n\n"
                )
                prompt_lines.append(
                    "请严格按照任务依赖图的顺序，建立Agent蜂群分发任务，编写完整的功能代码。\n"
                    "要求：\n"
                    "1. 按照依赖图拓扑顺序执行，确保前置依赖完成后才开始后续任务\n"
                    "2. 每个模块编写完整的TDD测试用例后再编写实现代码\n"
                    "3. 代码必须符合架构设计方案的技术选型和规范\n"
                    "4. 每个函数/类都要有清晰的注释和文档字符串\n"
                    "5. 直接输出代码文件内容，标注文件路径\n\n"
                    "直接输出代码，不要输出思考过程。"
                )
                prompt = "\n".join(prompt_lines)

                full_reply = []
                client = GatewayClient(profile_name="houfa", timeout=5400)  # 90分钟超时
                async for chunk in client.chat_completions(
                    messages=[{"role": "user", "content": prompt}],
                    stream=True,
                    max_tokens=16384,
                ):
                    full_reply.append(chunk)
                    if len(full_reply) % 10 == 0:
                        await broadcast(project_id, {"type": "progress", "message": f"📝 后发持续编码中...（已生成 {len(''.join(full_reply))} 字符）"})

                await broadcast(project_id, {"type": "stage", "message": "📝 所有功能代码已生成，正在进行质量检查..."})

                reply = "".join(full_reply).strip()
                if reply and len(reply) >= 50:
                    artifacts = {
                        "code": reply,
                        "code_plan_source": str(code_plan)[:500],
                        "dependency_graph_source": str(dependency_graph)[:500],
                        "tdd_cases_source": str(tdd_cases)[:500],
                        "status": "done",
                        "message": "✅ 功能代码编写完成",
                    }
                    bg_engine.save_step9_artifacts(artifacts)
                    bg_engine.complete_step(9)
                    await broadcast(project_id, {"type": "done", "message": "✅ 所有功能代码已全部编写完毕，等待 QA 检验"})
                else:
                    bg_engine.save_step9_artifacts({
                        "status": "error",
                        "message": "❌ 后发未生成有效代码，请重新执行",
                    })
                    bg_engine.reset_step(9)
                    await broadcast(project_id, {"type": "error", "message": "❌ 后发未生成有效代码，请重新执行"})
            except Exception as e:
                logger.error(f"HouFa background generation failed: {e}")
                try:
                    bg_engine = WorkflowEngine(project_id=project_id, db=bg_db)
                    bg_engine.save_step9_artifacts({
                        "status": "error",
                        "message": f"❌ 后发编写失败: {str(e)[:200]}",
                    })
                    bg_engine.reset_step(9)
                except Exception:
                    pass
                try:
                    await broadcast(project_id, {"type": "error", "message": f"❌ 后发编写失败: {str(e)[:200]}"})
                except Exception:
                    pass
            finally:
                bg_db.close()
        except Exception as e:
            logger.error(f"HouFa background task fatal: {e}")

    _asyncio.create_task(_generate())

    return APIResponse(code=0, data={
        "message": "第九步已启动，后发正在建立蜂群编写功能代码（约60分钟）",
        "status": "generating",
    })


