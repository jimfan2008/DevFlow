# ============================================
# GBM AI Agent HR - Environment Variables
# ============================================

# ============================================
# Database Configuration (MySQL 8.x)
# ============================================
DB_HOST=mysql
DB_PORT=3306
DB_ROOT_PASSWORD=gbm_hr_root_2026
DB_USER=gbm_hr_admin
DB_PASSWORD=gbm_hr_admin_2026

# ============================================
# Redis Configuration (Redis 7.x)
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=gbm_redis_2026

# ============================================
# Kafka Configuration (3-node cluster)
# ============================================
KAFKA_BOOTSTRAP_SERVERS=kafka1:9092,kafka2:9092,kafka3:9092
KAFKA_TOPIC_PREFIX=gbm.hr

# ============================================
# MinIO Configuration (Object Storage)
# ============================================
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=gbm_minio_admin
MINIO_SECRET_KEY=gbm_minio_secret_2026

# ============================================
# Keycloak SSO Configuration
# ============================================
KEYCLOAK_SERVER_URL=http://keycloak:8080
KEYCLOAK_REALM=gbm-hr
KEYCLOAK_CLIENT_ID=gbm-hr-client
KEYCLOAK_CLIENT_SECRET=gbm_keycloak_secret_2026
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=gbm_admin_2026

# ============================================
# Camunda 8 (Zeebe) Configuration
# ============================================
CAMUNDA_ZEEBE_ADDRESS=zeebe:26500
CAMUNDA_OPERATE_URL=http://camunda-operate:8080

# ============================================
# AI Model Services Configuration
# ============================================
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
LOCAL_LLM_ENDPOINT=http://localhost:8000
EMBEDDING_MODEL=bge-m3
EMBEDDING_ENDPOINT=http://localhost:8001

# ============================================
# Python Sub-Service Endpoints
# ============================================
RPA_SERVICE_URL=http://rpa-service:8090
OCR_SERVICE_URL=http://ocr-service:8091
FACE_SERVICE_URL=http://face-service:8092

# ============================================
# Elasticsearch Configuration
# ============================================
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=gbm_elasticsearch_2026

# ============================================
# Milvus Configuration (Vector Database)
# ============================================
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION=resume_embeddings

# ============================================
# Notification Services
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=hr@gbm.com
SMTP_PASSWORD=your_smtp_password_here

# ============================================
# Monitoring & Observability
# ============================================
PROMETHEUS_ENDPOINT=http://prometheus:9090
GRAFANA_ENDPOINT=http://grafana:3000
GRAFANA_ADMIN_PASSWORD=gbm_grafana_2026

# ============================================
# Application Settings
# ============================================
APP_ENV=development
APP_PORT=8080
APP_TIMEZONE=Asia/Shanghai
APP_LOCALE=zh_CN
LOG_LEVEL=DEBUG

# AES-256 encryption key for sensitive data (32 bytes = 256 bits)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ============================================
# RPA Configuration
# ============================================
RPA_HEADLESS=true
RPA_TIMEOUT=60000
RPA_RETRIES=3

# ============================================
# OCR Configuration
# ============================================
OCR_LANG=ch
OCR_USE_GPU=false

# ============================================
# Domain Service Ports
# ============================================
USER_DOMAIN_PORT=8081
RECRUIT_DOMAIN_PORT=8082
PAYROLL_DOMAIN_PORT=8083
AUTO_DOMAIN_PORT=8084
