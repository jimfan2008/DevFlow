FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y     gcc     g++     libgl1-mesa-glx     libglib2.0-0     && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir     fastapi     uvicorn     insightface     onnxruntime     opencv-python     kafka-python     pydantic     pydantic-settings     numpy

COPY app/agent/face.py ./face_service.py

RUN mkdir -p /app/models/face

EXPOSE 9003

CMD ["uvicorn", "face_service:app", "--host", "0.0.0.0", "--port", "9003"]
