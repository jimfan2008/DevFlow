FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y     gcc     g++     libgl1-mesa-glx     libglib2.0-0     && rm -rf /var/lib/apt/lists/*

# 安装 OCR 依赖
RUN pip install --no-cache-dir     fastapi     uvicorn     paddleocr     paddlepaddle     opencv-python     kafka-python     pydantic     pydantic-settings

COPY app/agent/ocr.py ./ocr_service.py

EXPOSE 9001

CMD ["uvicorn", "ocr_service:app", "--host", "0.0.0.0", "--port", "9001"]
