FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y     gcc     g++     libgbm1     libnss3     libatk-bridge2.0-0     libdrm2     libxkbcommon0     libxcomposite1     libxdamage1     libxrandr2     libasound2     libpango-1.0-0     libcairo2     libcups2     libdrm2     libgbm1     libgtk-3-0     libatspi2.0-0     libxshmfence1     && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir     fastapi     uvicorn     playwright     selenium     kafka-python     pydantic     pydantic-settings     pillow     httpx

RUN python -m playwright install chromium

COPY app/agent/rpa.py ./rpa_service.py

RUN mkdir -p /app/screenshots

EXPOSE 9002

CMD ["uvicorn", "rpa_service:app", "--host", "0.0.0.0", "--port", "9002"]
