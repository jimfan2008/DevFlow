    def handle_dissatisfaction(self, event):
        trigger_time = event.get("timestamp") or self.system.current_time
        deadline = trigger_time + timedelta(hours=2)
        reason = event.get("feedback", "")
        project_id = event.get("project_id", "")
        round_id = event.get("round_id", "")

        self.record(project_id=project_id, round_id=round_id, reason=reason)

        self.iterator.trigger_iteration(
            project_id=project_id,
            round_id=round_id,
            reason=reason,
            deadline=deadline,
        )

        for agent in self.agents:
            self.notification_service.send(
                recipient=agent.name,
                notification_type="iteration_triggered",
                message=f"Project {project_id} iteration triggered due to user dissatisfaction: {reason}",
                deadline=deadline,
            )

