    gap: $spacing-xs;
    margin-bottom: $spacing-xs;
  }

  &__row {
    display: flex;
    gap: $spacing-xs;
    align-items: flex-end;
  }

  &__upload-btn {
    height: 56px;
    width: 40px;
    padding: 0 !important;
    font-size: 18px;
