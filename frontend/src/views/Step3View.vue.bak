  }

  &__qa-cursor {
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  &__qa-dimensions {
    text-align: left;
    padding: 0 $spacing-4 $spacing-4;
  }

  &__qa-dimension {
